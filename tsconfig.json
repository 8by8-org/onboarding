{
  "include": ["src", "*.config.ts"],
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false
  }
}
